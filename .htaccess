# OneCore — onecoreapp.com.mx (Hostinger)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Cabeceras de seguridad. Sin HSTS, el primer acceso por http podía
# interceptarse antes de la redirección; sin las otras, la web se podía meter
# en un iframe ajeno o el navegador adivinar tipos de archivo.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

RewriteEngine On

# Siempre por HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www → sin www. Apple pide el archivo de enlaces en el dominio exacto y sin
# redirecciones, así que el dominio bueno es el que no lleva www.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# /g/CODIGO → la página de invitación a un grupo (la app abre estos enlaces
# directamente; esta página es para quien todavía no la tiene).
RewriteRule ^g/[A-Za-z0-9]+/?$ /g/index.html [L]
# /p/CODIGO → la página de invitación a un proyecto, igual que /g/.
RewriteRule ^p/[A-Za-z0-9]+/?$ /p/index.html [L]

# /invita/CODIGO → la página de "te invitaron a OneCore".
RewriteRule ^invita/[A-Za-z0-9]+/?$ /invita/index.html [L]

# El archivo de enlaces de Apple: JSON, sin extensión.
<Files "apple-app-site-association">
  ForceType application/json
  <IfModule mod_headers.c>
    Header set Content-Type "application/json"
  </IfModule>
</Files>

# La vista previa de la portada nueva ya es la portada.
Redirect 301 /nuevo/ https://onecoreapp.com.mx/
